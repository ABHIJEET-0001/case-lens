# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=caselens
POSTGRES_PASSWORD=changeme
POSTGRES_DB=caselens_db
DATABASE_URL=postgresql://caselens:changeme@db:5432/caselens_db

# ── Auth ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── External APIs ─────────────────────────────────────────────────────────────
# Set your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ── App settings ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=info
# Enable demo role switching (never true in production)
DEMO_MODE=false
# Backend base URL (used by Next.js rewrites)
BACKEND_URL=http://localhost:8000
# Comma-separated CORS origins for the backend
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Frontend (Next.js) – exposed to browser
NEXT_PUBLIC_DEMO_MODE=false
